# GitHub Models — required for agent pipeline
# Get your token: github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=your_github_token_here

# LangSmith — optional but recommended (free at smith.langchain.com)
# Enables full trace URL of every agent LLM call
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=event-ledger

# App config — defaults work for local development
DATABASE_URL=sqlite:///./ledger.db
APP_PORT=8000
LOG_LEVEL=INFO
